{
    "openapi": "3.0.0",
    "info": {
        "title": "Mini LinkedIn API",
        "version": "1.0.0",
        "description": "API documentation for the Mini LinkedIn application."
    },
    "servers": [
        {
            "url": "http://localhost:4700",
            "description": "Local server"
        }
    ],
    "paths": {
        "/v1/job/create": {
            "post": {
                "summary": "Create a new job",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "minLength": 3,
                                        "maxLength": 150,
                                        "example": "Software Engineer"
                                    },
                                    "description": {
                                        "type": "string",
                                        "minLength": 10,
                                        "maxLength": 1500,
                                        "example": "We are looking for a skilled software engineer to join our team."
                                    },
                                    
                                    "salaryMin": {
                                        "type": "number",
                                        "example": 80000
                                    },
                                    "salaryMax": {
                                        "type": "number",
                                        "example": 120000
                                    },
                                    "experienceLevel": {
                                        "type": "string",
                                        "example": "Mid-level"
                                    },
                                    "availableTill": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2023-12-31"
                                    },
                                    "employmentType": {
                                        "type": "string",
                                        "example": "Full-time"
                                    }
                                },
                                "required": ["title", "description", "salaryMin", "salaryMax", "experienceLevel", "availableTill", "employmentType"]
                            }
                        }
                },
                "responses": {
                    "201": {
                        "description": "Job created successfully"
                    },
                    "400": {
                        "description": "Invalid input"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            }
            
        }
    }
}
}